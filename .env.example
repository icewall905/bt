# Shared passphrase for the web UI (empty = no login). Recommended since bt.tdgs.org is reachable via rproxy.
BT_PASSWORD=
# Cookie signing secret (auto-generated into data/.secret if empty)
BT_SECRET=
# Defaults for first start; editable later in Settings → AI
BT_LLM_BASE_URL=http://10.0.10.23:8080/v1
BT_LLM_MODEL=currentmodel
BT_LLM_API_KEY=
BT_POT_URL=http://pot:4416
# pip install -U yt-dlp at container start (1/0)
BT_YTDLP_AUTOUPDATE=1
# Host dir for offline video cache (mounted at /media)
BT_MEDIA_HOST_DIR=/mnt/local/localstorage/bt
